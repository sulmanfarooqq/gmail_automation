# FlowVello Gmail Agent Configuration

# Gemini AI API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key-here

# Gmail API OAuth settings
# (credentials.json goes in project root)
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_DIR=credentials

# Flask dashboard
FLASK_SECRET_KEY=change-this-to-a-random-string
FLASK_PORT=5000
FLASK_DEBUG=true

# Email processing
SCAN_INTERVAL_MINUTES=5
MAX_EMAILS_PER_SCAN=20
FOLLOWUP_CHECK_HOURS=6

# AI settings
AI_MODEL=gemini-1.5-flash
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=1024

# Notification
NOTIFY_ON_LEAD=true
NOTIFY_ON_URGENT=true

# Hours to estimate as saved per automated email
HOURS_SAVED_PER_EMAIL=0.1

# Supabase Knowledge Base (for agency docs, SOPs, agreements)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
